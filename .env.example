# Copy to .env and fill in. NEVER commit .env.
# Delta Exchange DEMO / testnet API credentials (https://testnet.delta.exchange)
DELTA_API_KEY=your_demo_api_key_here
DELTA_API_SECRET=your_demo_api_secret_here

# Google Gemini (optional — AI narration & analysis). https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# MongoDB Atlas — persists trades and runtime state. Leave unset to disable.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/tradeos
# Shared MongoDB automatically elects one Delta executor. To force a role:
# TRADEOS_EXECUTION_ROLE=read_only  # use on a local monitoring-only instance
# TRADEOS_INSTANCE_ID=render-primary

# Fixed-IP outbound proxy — keeps Delta's IP whitelist stable even if your
# connection's public IP changes. Leave unset to disable.
# DELTA_PROXY_URL=http://user:pass@proxy-ip:port

# Dashboard access token — REQUIRED if the server is reachable from the public
# internet (e.g. deployed on Render/Railway/a VPS). Leave unset only for local-
# only use (127.0.0.1). Pick a long random value; it's your login password.
TRADEOS_TOKEN=
# Optional alerts (configure any one or more):
# TRADEOS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_FROM=tradeos@example.com
# ALERT_EMAIL_TO=you@example.com
# HOST=0.0.0.0   # set on cloud hosts to accept external connections
# PORT=8000      # most hosts (Render) inject PORT automatically
